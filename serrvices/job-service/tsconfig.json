{
    "include": [
      "src/**/*.ts",
      "prisma/**/*.ts"
    ],
    "exclude": [
      "node_modules",
      "dist"
    ],
    "compilerOptions": {
      "noEmitOnError": true,
      "skipLibCheck": true,
      "strict": false,
      "sourceMap": true,
      "module": "commonjs",
      "moduleResolution": "node",
      "allowJs": false,
      "rootDir": ".",
      "outDir": "dist",
      "declaration": true,
      "target": "ES2020",
      "resolveJsonModule": true,
      "esModuleInterop": true,
      "declarationMap": true,
      "types": [
        "node",
        "jest"
      ]
    }
  }
