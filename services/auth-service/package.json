{
  "name": "auth-service",
  "version": "0.1.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "redis": "redis-server",
    "worker:email": "ts-node-dev --respawn src/workers/emailVerification.worker.ts",
    "worker:employer": "ts-node-dev --respawn src/workers/employerApproval.worker.ts",
    "worker:approval-notify": "ts-node-dev --respawn src/workers/approvalNotification.worker.ts",
    "prisma:studio": "prisma studio",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:reset": "prisma migrate reset",
    "seed:admin": "ts-node prisma/seed.ts",
    "admin:revoke": "ts-node-dev --transpile-only --exit-child src/cli/revokeRefreshToken.ts",
    "test": "jest --runInBand",
    "nats": "powershell -Command \"& 'D:/Downloads/Apps+Tools/nats-server-v2.12.2-windows-amd64/nats-server.exe'\""
  },
  "dependencies": {
    "@prisma/client": "5.19.1",
    "axios": "^1.13.2",
    "bcrypt": "5.1.1",
    "bullmq": "5.12.2",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.21.2",
    "ioredis": "5.4.1",
    "jose": "5.3.0",
    "jsonwebtoken": "9.0.2",
    "nats": "2.20.0",
    "nodemailer": "^7.0.9",
    "pino": "^10.0.0",
    "prom-client": "15.1.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "5.0.0",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "9.0.5",
    "@types/node": "22.7.2",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.2",
    "prisma": "5.19.1",
    "supertest": "^6.3.4",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "2.0.0",
    "typescript": "5.5.4"
  }
}
