# Copy this file to .env for local development

PORT = 3001

# MySQL connection string with connection pooling
# connection_limit: Maximum number of connections in pool (default: 10)
# pool_timeout: Timeout in seconds when acquiring connection (default: 30)
DATABASE_URL=mysql://root:@localhost:3306/find_job?connection_limit=20&pool_timeout=30

# Redis connection used for rate limiting and BullMQ queues
REDIS_URL=redis://127.0.0.1:6379
REDIS_RATE_LIMIT_NAMESPACE=job-post-rate
REDIS_QUEUE_NAMESPACE=job-post-queue

# Notification service REST endpoint for sending emails
NOTIFICATION_SERVICE_URL=http://localhost:4005
# Default locale used when none is provided by the job payload
NOTIFICATION_SERVICE_DEFAULT_LOCALE=en

# Minutes before email verification codes expire
EMAIL_VERIFY_CODE_TTL_MIN=30

# Requests per minute (per IP) allowed for registration endpoint
AUTH_RATE_LIMIT_REGISTER_PER_MIN=10

# Requests per minute (per IP) allowed for login endpoint
AUTH_RATE_LIMIT_LOGIN_PER_MIN=10

# Resend verification attempts per hour (per email)
AUTH_RATE_LIMIT_RESEND_PER_HOUR=3

# Refresh token rotations allowed per minute (per token/device)
AUTH_RATE_LIMIT_REFRESH_PER_MIN=30

# Token lifetimes (seconds/minutes)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# JWT signing (insert PEM content for real deployments)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=auth-service
JWT_AUDIENCE=job-finder-clients

# Local storage for job images
JOB_IMAGES_DIR=storage/job-images

# CV storage settings
CV_STORAGE_DIR=storage/cv-library
CV_MAX_FILES_PER_CANDIDATE=5
CV_MAX_FILE_SIZE_BYTES=10485760
CV_ALLOWED_MIME_TYPES=application/pdf
CV_SIGNED_URL_TTL_SECONDS=300
CV_SIGNING_SECRET=replace-this-secret

# Gemini CV analysis
GEMINI_API_KEY=test-gemini-key
GEMINI_MODEL=gemini-1.5-flash
GEMINI_REQUEST_TIMEOUT_MS=60000

# OCR settings
OCR_PROVIDER=tesseract
TESSERACT_LANG=eng
OCR_DPI=220

# BullMQ / queues
JOB_APPROVAL_QUEUE=jobApprovalQueue
CV_PROCESSING_QUEUE=cvProcessingQueue
CV_DLQ=cvProcessingQueue.dlq
BULLMQ_PREFIX=job-service

# Job creation rate limit
JOB_RATE_LIMIT_MAX=5
JOB_RATE_LIMIT_WINDOW_MINUTES=10
JOB_SEARCH_CACHE_TTL_SECONDS=30
LOCATION_SEED_VERSION=2025-11-17

# Mail configuration for sending notifications
MAIL_SENDER=no-reply@bonenet.local
MAIL_SMTP_HOST=127.0.0.1
MAIL_SMTP_PORT=1025
MAIL_SMTP_SECURE=false
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=

# For Gmail, use:
# MAIL_SMTP_HOST=smtp.gmail.com
# MAIL_SMTP_PORT=587
# MAIL_SMTP_SECURE=false
# MAIL_SMTP_USERNAME=your-email@gmail.com
# MAIL_SMTP_PASSWORD=your-app-password

# Event bus
EVENT_BUS_URL=nats://127.0.0.1:4222

# ClamAV daemon
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=10000

# Internal API authentication for cross-service calls
INTERNAL_API_SECRET=dev-internal-secret

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
